// Fix: fix-5 — trainingsmomenten, roosterperiodes en beschikbaarheid.
// Fix: fix-3 — coördinator, taken (jaarplan, teambeheer, toezicht) en groep toezichthouders.
// Fix: fix-2 — testtrainers (zonder account) toegestaan voor de hoofdtrainer.
// Fix: fix-1 — beveiligingsregels voor de NatUtrecht Trainersapp.
//
// Uitgangspunt: iedereen met de (publieke) Firebase-config kan een account
// aanmaken. Toegang tot de data hangt daarom NIET af van "ingelogd zijn",
// maar van het bestaan van een document trainers/{uid}.
//
// Rechten:
//  - coordinator == true      → alles (team, jaarplan, rooster).
//  - teamBeheer == true       → team beheren, maar geen coördinatoren aanmaken,
//                               wijzigen of verwijderen en geen teambeheer uitdelen.
//  - jaarplanBeheer == true   → jaarplan bewerken.
//  Documenten van vóór fix-3 met rol 'Hoofdtrainer' tellen als coördinator.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Hulpfuncties -------------------------------------------------------

    function ingelogd() {
      return request.auth != null;
    }
    function trainerPad(uid) {
      return /databases/$(database)/documents/trainers/$(uid);
    }
    function setupPad() {
      return /databases/$(database)/documents/config/setup;
    }
    function isTrainer() {
      return ingelogd() && exists(trainerPad(request.auth.uid));
    }
    function ikData() {
      return get(trainerPad(request.auth.uid)).data;
    }
    function coordinatorIn(d) {
      return d.get('coordinator', false) == true || d.get('rol', '') == 'Hoofdtrainer';
    }
    function isCoordinator() {
      return isTrainer() && coordinatorIn(ikData());
    }
    function magTeam() {
      return isTrainer() && (coordinatorIn(ikData()) || ikData().get('teamBeheer', false) == true);
    }
    // Na de schrijfactie (nodig binnen de inrichtings-batch).
    function isCoordinatorNa() {
      return ingelogd()
        && existsAfter(trainerPad(request.auth.uid))
        && coordinatorIn(getAfter(trainerPad(request.auth.uid)).data);
    }
    function magJaarplanNa() {
      return ingelogd()
        && existsAfter(trainerPad(request.auth.uid))
        && (coordinatorIn(getAfter(trainerPad(request.auth.uid)).data)
            || getAfter(trainerPad(request.auth.uid)).data.get('jaarplanBeheer', false) == true);
    }
    function geverifieerdEmail() {
      return ingelogd()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function mijnEmail() {
      return request.auth.token.email.lower();
    }
    // E-mailadres van de beoogde eerste coördinator. Wordt bij het deployen
    // ingevuld vanuit de GitHub-variabele HOOFDTRAINER_EMAIL, zodat niemand
    // anders de app kan "inrichten" vóór de coördinator dat doet.
    function beoogdeHoofdtrainer() {
      return '__HOOFDTRAINER_EMAIL__';
    }
    function uitnodigingPad(email) {
      return /databases/$(database)/documents/uitnodigingen/$(email);
    }
    function isRol(r) {
      return r in ['Trainer', 'Assistent-trainer', 'Geen training'];
    }
    function isDatum(d) {
      return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function tekst(v, max) {
      return v is string && v.size() <= max;
    }
    function isBoolVeld(d, veld) {
      return !(veld in d) || d[veld] is bool;
    }
    function takenGeldig(d) {
      return isBoolVeld(d, 'coordinator') && isBoolVeld(d, 'jaarplanBeheer') && isBoolVeld(d, 'teamBeheer') && isBoolVeld(d, 'toezichthouder');
    }
    // Geeft dit document coördinator- of teambeheer-rechten?
    function zwareTaken(d) {
      return d.get('coordinator', false) == true || d.get('teamBeheer', false) == true;
    }
    function geldigeTrainer(d) {
      return d.keys().hasOnly(['naam', 'initialen', 'kleur', 'rol', 'specialiteit', 'email', 'sinds', 'test',
                               'coordinator', 'jaarplanBeheer', 'teamBeheer', 'toezichthouder'])
        && tekst(d.naam, 80) && d.naam.size() > 0
        && tekst(d.initialen, 3) && d.initialen.size() > 0
        && tekst(d.kleur, 9) && d.kleur.matches('^#[0-9a-fA-F]{6}$')
        && isRol(d.rol)
        && tekst(d.specialiteit, 120)
        && tekst(d.email, 254)
        && isBoolVeld(d, 'test')
        && takenGeldig(d);
    }
    // Rol en taken van een uitnodiging moeten exact worden overgenomen.
    function zelfdeAlsUitnodiging(d, u) {
      return d.rol == u.rol
        && d.get('coordinator', false) == u.get('coordinator', false)
        && d.get('jaarplanBeheer', false) == u.get('jaarplanBeheer', false)
        && d.get('teamBeheer', false) == u.get('teamBeheer', false)
        && d.get('toezichthouder', false) == u.get('toezichthouder', false);
    }

    // --- Inrichting ---------------------------------------------------------

    match /config/setup {
      allow read: if ingelogd();
      // Alleen de allereerste keer, samen met het eigen coördinator-document.
      allow create: if geverifieerdEmail()
        && mijnEmail() == beoogdeHoofdtrainer()
        && !exists(setupPad())
        && request.resource.data.keys().hasOnly(['hoofdtrainerUid', 'op'])
        && request.resource.data.hoofdtrainerUid == request.auth.uid
        && request.resource.data.op == request.time
        && isCoordinatorNa();
      allow update, delete: if false;
    }

    // --- Teamleden ----------------------------------------------------------

    match /trainers/{uid} {
      allow read: if isTrainer() || (ingelogd() && request.auth.uid == uid);

      allow create: if geldigeTrainer(request.resource.data)
        && (!('sinds' in request.resource.data) || request.resource.data.sinds == request.time)
        && (
        // 1. Coördinator voegt iemand toe; teambeheer zonder zware taken.
        isCoordinator()
        || (magTeam() && !zwareTaken(request.resource.data))
        // 2. Eerste inrichting: jezelf als coördinator, samen met config/setup.
        || (geverifieerdEmail()
            && mijnEmail() == beoogdeHoofdtrainer()
            && uid == request.auth.uid
            && !exists(setupPad())
            && existsAfter(setupPad())
            && request.resource.data.get('coordinator', false) == true
            && request.resource.data.email == mijnEmail())
        // 3. Een uitnodiging verzilveren: rol en taken moeten overeenkomen en
        //    de uitnodiging wordt in dezelfde batch verwijderd.
        || (geverifieerdEmail()
            && uid == request.auth.uid
            && exists(uitnodigingPad(mijnEmail()))
            && !existsAfter(uitnodigingPad(mijnEmail()))
            && zelfdeAlsUitnodiging(request.resource.data, get(uitnodigingPad(mijnEmail())).data)
            && request.resource.data.email == mijnEmail())
      );

      allow update: if geldigeTrainer(request.resource.data)
        && (
          // Coördinator: alles, maar zichzelf de coördinatortaak niet afnemen,
          // zodat er altijd minstens één coördinator blijft.
          (isCoordinator()
            && (uid != request.auth.uid || request.resource.data.get('coordinator', false) == true))
          // Teambeheer: niet bij coördinatoren, en geen zware taken veranderen.
          || (magTeam()
            && !coordinatorIn(resource.data)
            && request.resource.data.get('coordinator', false) == resource.data.get('coordinator', false)
            && request.resource.data.get('teamBeheer', false) == resource.data.get('teamBeheer', false))
        );

      allow delete: if magTeam()
        && uid != request.auth.uid
        && (isCoordinator() || !coordinatorIn(resource.data));
    }

    // --- Uitnodigingen (id = e-mailadres in kleine letters) -----------------

    match /uitnodigingen/{email} {
      allow read: if magTeam() || (geverifieerdEmail() && email == mijnEmail());
      allow create, update: if magTeam()
        && (isCoordinator() || !zwareTaken(request.resource.data))
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'naam', 'rol', 'kleur', 'specialiteit', 'uitgenodigdOp',
                                                 'coordinator', 'jaarplanBeheer', 'teamBeheer', 'toezichthouder'])
        && request.resource.data.email == email
        && tekst(request.resource.data.naam, 80) && request.resource.data.naam.size() > 0
        && isRol(request.resource.data.rol)
        && tekst(request.resource.data.kleur, 9) && request.resource.data.kleur.matches('^#[0-9a-fA-F]{6}$')
        && tekst(request.resource.data.specialiteit, 120)
        && isDatum(request.resource.data.uitgenodigdOp)
        && takenGeldig(request.resource.data);
      allow delete: if (magTeam() && (isCoordinator() || !zwareTaken(resource.data)))
        || (geverifieerdEmail() && email == mijnEmail());
    }

    // --- Groep toezichthouders (zonder account) ------------------------------

    match /toezichthouders/{id} {
      allow read: if isTrainer();
      allow create, update: if magTeam()
        && request.resource.data.keys().hasOnly(['naam', 'notitie'])
        && tekst(request.resource.data.naam, 80) && request.resource.data.naam.size() > 0
        && tekst(request.resource.data.notitie, 200);
      allow delete: if magTeam();
    }

    // --- Nieuw rooster (fix-5): momenten, periodes, beschikbaarheid ---------

    function isTijd(t) {
      return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function periodePad(pid) {
      return /databases/$(database)/documents/roosterperiodes/$(pid);
    }

    match /trainingsmomenten/{id} {
      allow read: if isTrainer();
      allow create, update: if isCoordinator()
        && request.resource.data.keys().hasOnly(['dag', 'start', 'eind', 'locatie', 'trainersNodig', 'actief', 'volgorde'])
        && request.resource.data.dag is int && request.resource.data.dag >= 0 && request.resource.data.dag <= 6
        && isTijd(request.resource.data.start) && isTijd(request.resource.data.eind)
        && request.resource.data.start < request.resource.data.eind
        && tekst(request.resource.data.locatie, 80)
        && request.resource.data.trainersNodig is int
        && request.resource.data.trainersNodig >= 1 && request.resource.data.trainersNodig <= 6
        && request.resource.data.actief is bool
        && request.resource.data.volgorde is int;
      allow delete: if isCoordinator();
    }

    match /roosterperiodes/{pid} {
      allow read: if isTrainer();
      allow create, update: if isCoordinator()
        && request.resource.data.keys().hasOnly([
             'naam', 'soort', 'van', 'tot', 'status', 'deadline', 'momentIds', 'losseTrainingen',
             'vervallenData', 'versie', 'aangemaaktOp'])
        && tekst(request.resource.data.naam, 80) && request.resource.data.naam.size() > 0
        && request.resource.data.soort in ['wekelijks', 'los']
        && isDatum(request.resource.data.van) && isDatum(request.resource.data.tot)
        && request.resource.data.van <= request.resource.data.tot
        && request.resource.data.status in ['concept', 'beschikbaarheid', 'indelen', 'gepubliceerd', 'afgesloten']
        && (request.resource.data.deadline == null || isDatum(request.resource.data.deadline))
        && request.resource.data.momentIds is list && request.resource.data.momentIds.size() <= 20
        && request.resource.data.losseTrainingen is list && request.resource.data.losseTrainingen.size() <= 100
        && request.resource.data.vervallenData is list && request.resource.data.vervallenData.size() <= 200;
      allow delete: if isCoordinator() && resource.data.status == 'concept';

      // Iedereen ziet ieders beschikbaarheid (besluit 19 nov). Een trainer vult
      // alleen de eigen in, zolang de periode beschikbaarheid opvraagt; de
      // coördinator mag altijd (bijv. na rondbellen).
      match /beschikbaarheid/{uid} {
        allow read: if isTrainer();
        allow create, update: if isTrainer()
          && request.resource.data.keys().hasOnly(['keuzes', 'maxPerMaand', 'nietKunnen', 'bijgewerktOp', 'bijgewerktDoor'])
          && request.resource.data.keuzes is map && request.resource.data.keuzes.size() <= 100
          && (request.resource.data.maxPerMaand == null
              || (request.resource.data.maxPerMaand is int
                  && request.resource.data.maxPerMaand >= 0 && request.resource.data.maxPerMaand <= 31))
          && request.resource.data.nietKunnen is list && request.resource.data.nietKunnen.size() <= 30
          && request.resource.data.bijgewerktOp == request.time
          && request.resource.data.bijgewerktDoor == request.auth.uid
          && exists(trainerPad(uid))
          && (isCoordinator()
              || (uid == request.auth.uid && get(periodePad(pid)).data.status == 'beschikbaarheid'));
        allow delete: if isCoordinator();
      }
    }

    // Collection-group-query op alle beschikbaarheid (voor overzichten).
    match /{pad=**}/beschikbaarheid/{uid} {
      allow read: if isTrainer();
    }

    // --- Rooster ------------------------------------------------------------

    match /roosterWijzigingen/{slot} {
      allow read: if isTrainer();
      allow create, update: if isTrainer()
        && request.resource.data.keys().hasOnly(['weekStart', 'sessieId', 'groepId', 'trainerId', 'gewijzigdDoor', 'gewijzigdOp'])
        && isDatum(request.resource.data.weekStart)
        && tekst(request.resource.data.sessieId, 40)
        && tekst(request.resource.data.groepId, 40)
        && slot == request.resource.data.weekStart + '|' + request.resource.data.sessieId + '|' + request.resource.data.groepId
        && (request.resource.data.trainerId == null || exists(trainerPad(request.resource.data.trainerId)))
        && request.resource.data.gewijzigdDoor == request.auth.uid
        && request.resource.data.gewijzigdOp == request.time;
      allow delete: if isTrainer();
    }

    match /afwezigheden/{id} {
      allow read: if isTrainer();
      // Zelf melden volgt later; nu alleen eigen of door de coördinator.
      function geldigeAfwezigheid(d) {
        return d.keys().hasOnly(['trainerId', 'van', 'tot', 'reden'])
          && d.trainerId is string && exists(trainerPad(d.trainerId))
          && isDatum(d.van) && isDatum(d.tot) && d.van <= d.tot
          && tekst(d.reden, 200);
      }
      allow create: if isTrainer()
        && (request.resource.data.trainerId == request.auth.uid || isCoordinator())
        && geldigeAfwezigheid(request.resource.data);
      allow update: if isTrainer()
        && (isCoordinator()
            || (resource.data.trainerId == request.auth.uid
                && request.resource.data.trainerId == request.auth.uid))
        && geldigeAfwezigheid(request.resource.data);
      allow delete: if isTrainer() && (resource.data.trainerId == request.auth.uid || isCoordinator());
    }

    // --- Trainingen ---------------------------------------------------------

    match /trainingen/{id} {
      allow read: if isTrainer();
      allow create: if isTrainer()
        && request.resource.data.keys().hasOnly([
             'datum', 'sessieId', 'groepId', 'trainerId', 'titel', 'focus', 'blokken',
             'notities', 'bijlage', 'aangemaaktDoor', 'aangemaaktOp'])
        && isDatum(request.resource.data.datum)
        && tekst(request.resource.data.sessieId, 40) && request.resource.data.sessieId.size() > 0
        && tekst(request.resource.data.groepId, 40) && request.resource.data.groepId.size() > 0
        && request.resource.data.trainerId is string
        && exists(trainerPad(request.resource.data.trainerId))
        && tekst(request.resource.data.titel, 200)
        && request.resource.data.focus is list && request.resource.data.focus.size() <= 10
        && request.resource.data.blokken is list && request.resource.data.blokken.size() <= 30
        && tekst(request.resource.data.notities, 5000)
        && (!('bijlage' in request.resource.data) || tekst(request.resource.data.bijlage, 255))
        && request.resource.data.aangemaaktDoor == request.auth.uid
        && request.resource.data.aangemaaktOp == request.time;
      allow delete: if isTrainer() && (
        resource.data.aangemaaktDoor == request.auth.uid
        || resource.data.trainerId == request.auth.uid
        || isCoordinator()
      );
      allow update: if false;
    }

    // --- Jaarplan -----------------------------------------------------------

    match /jaarplan/{id} {
      allow read: if isTrainer();
      allow create, update: if magJaarplanNa()
        && id == 'huidig'
        && request.resource.data.keys().hasOnly([
             'seizoen', 'van', 'tot', 'status', 'gepubliceerdOp', 'gepubliceerdDoor',
             'versie', 'periodes', 'evenementen'])
        && tekst(request.resource.data.seizoen, 40)
        && isDatum(request.resource.data.van) && isDatum(request.resource.data.tot)
        && request.resource.data.status in ['concept', 'gepubliceerd']
        && request.resource.data.versie is int && request.resource.data.versie >= 0
        && request.resource.data.periodes is list && request.resource.data.periodes.size() <= 30
        && request.resource.data.evenementen is list && request.resource.data.evenementen.size() <= 100;
      allow delete: if false;
    }

    // Al het overige is dicht.
  }
}
